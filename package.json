{
  "name": "neva",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace @neva/mobile",
    "web": "npm run dev --workspace @neva/web",
    "build:web": "npm run build --workspace @neva/web",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
