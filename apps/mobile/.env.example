# Copy to `.env` and fill in. EXPO_PUBLIC_* values are bundled into the app, so only public keys go here.
# Supabase › Project Settings › API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Set to 1 after enabling Google in Supabase › Auth › Providers
EXPO_PUBLIC_GOOGLE_SIGN_IN=0

# NEVER put these in the app or this file: service_role key, sb_secret_ key, database password, SMS provider secret.
